    "## 2. The engine\n",
    "\n",
    "`RippleField` is the entire simulation. Read the `step` method first: the rest is bookkeeping.\n",
    "\n",
    "Two imports, then the class."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "cell-03",
   "metadata": {
    "capture": true
   },
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"figure.facecolor\": \"white\",\n",
    "    \"axes.facecolor\": \"white\",\n",
    "    \"font.size\": 10,\n",
    "})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "cell-04",
   "metadata": {
    "capture": true
   },
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "\n",
    "class RippleField:\n",
    "    \"\"\"Finite-difference water surface.\n",
    "\n",
    "    u[i, j] is vertical displacement at cell (i, j). The update is the\n",
    "    explicit central-difference form of the 2D wave equation\n",
    "\n",
    "        u_tt + 2*gamma*u_t = c^2 * laplacian(u)\n",
    "\n",
    "    written with no trigonometric term anywhere: each new height is built\n",
    "    only from the four neighbouring heights and the cell's own previous two\n",
    "    heights.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, size=180, cfl=0.5, damping=0.0012,\n",
    "                 sponge_width=26, sponge_strength=0.08):\n",
    "        if cfl >= 0.70710678:\n",
    "            raise ValueError(\"cfl must stay below 1/sqrt(2) in 2D for stability\")\n",
    "        self.size = n = int(size)\n",
    "        self.cfl = float(cfl)\n",
    "        self.c2 = self.cfl ** 2\n",
    "\n",
    "        # Loss per cell per step. Uniform background damping plus a thicker\n",
    "        # absorbing band at the rim so outgoing rings leave instead of\n",
    "        # bouncing off a hard wall.\n",
    "        self.gamma = np.full((n, n), float(damping), dtype=np.float64)\n",
    "        if sponge_width > 0:\n",
    "            ramp = np.linspace(0.0, 1.0, sponge_width) ** 2\n",
    "            s = sponge_strength\n",
    "            self.gamma[:sponge_width, :] += s * ramp[:, None]\n",
    "            self.gamma[-sponge_width:, :] += s * ramp[::-1, None]\n",
    "            self.gamma[:, :sponge_width] += s * ramp[None, :]\n",
    "            self.gamma[:, -sponge_width:] += s * ramp[None, ::-1]\n",
    "\n",
    "        self.t = 0\n",
    "        self._yy, self._xx = np.ogrid[:n, :n]\n",
    "\n",
    "    # ------------------------------------------------------------------ #\n",
    "    def drop(self, x, y, radius=6.0, strength=1.0):\n",
    "        \"\"\"Push the surface down (or up) with a smooth circular cap.\n",
    "\n",
    "        Simple, but a cap has a net volume, so the grid keeps a permanent\n",
    "        offset. Use `crater` for a ripple that settles back to flat.\n",
    "        \"\"\"\n",
    "        n = self.size\n",
    "        if not (0 <= x < n and 0 <= y < n):\n",
    "            raise ValueError(\"drop centre is outside the grid\")\n",
    "        r2 = (self._xx - x) ** 2 + (self._yy - y) ** 2\n",
    "        self.u += strength * np.exp(-r2 / (2.0 * radius ** 2))\n",
    "\n",
    "    def crater(self, x, y, radius=3.0, rim=2.2, strength=1.0):\n",
    "        \"\"\"A volume-conserving dimple: depression in the middle, raised rim.\n",
    "\n",
    "        The two Gaussian widths are chosen so the integral over the plane is\n",
    "        exactly zero. Water is effectively incompressible, so anything pushed\n",
    "        down has to come up somewhere; this is the initial condition that\n",
    "        looks like a stone hitting a pond.\n",
    "        \"\"\"\n",
    "        n = self.size\n",
    "        if not (0 <= x < n and 0 <= y < n):\n",
    "            raise ValueError(\"crater centre is outside the grid\")\n",
    "        r2 = (self._xx - x) ** 2 + (self._yy - y) ** 2\n",
    "        sigma = float(radius)\n",
    "        sigma2 = float(radius) * float(rim)\n",
    "        a = float(strength)\n",
    "        b = a * sigma ** 2 / sigma2 ** 2\n",
    "        self.u += -a * np.exp(-r2 / (2.0 * sigma ** 2)) + b * np.exp(\n",
    "            -r2 / (2.0 * sigma2 ** 2)\n",
    "        )\n",
    "\n",
    "    def splash(self, x, y, radius=3.0, rim=2.2, strength=1.0):\n",
    "        \"\"\"Crater plus a downward starting velocity, closer to an impact.\"\"\"\n",
    "        before = self.u.copy()\n",
    "	       self.crater(x, y, radius=radius, rim=rim, strength=strength)
    "        self.u_prev -= 0.30 * (self.u - before)
    "\n",
    "    # ------------------------------------------------------------------ #\n",
    "    def step(self, count=1):\n",
    "        \"\"\"Advance the grid by `count` timesteps.\"\"\"\n",
    "        u, prev = self.u, self.u_prev\n",
    "        c2 = self.c2\n",
    "        g = self.gamma\n",
    "        for _ in range(int(count)):\n",
    "            lap = np.zeros_like(u)\n",
    "            lap[1:-1, 1:-1] = (\n",
    "                u[2:, 1:-1] + u[:-2, 1:-1] + u[1:-1, 2:] + u[1:-1, :-2]\n",
    "                - 4.0 * u[1:-1, 1:-1]\n",
    "            )\n",
    "            nxt = (2.0 * u - (1.0 - g) * prev + c2 * lap) / (1.0 + g)\n",
    "            prev = u\n",
    "            u = nxt\n",
    "            self.t += 1\n",
    "        self.u, self.u_prev = u, prev\n",
    "\n",
    "    # ------------------------------------------------------------------ #\n",
    "    def energy(self):\n",
    "        \"\"\"Discrete energy: kinetic from the last step, potential from slope.\"\"\"\n",  
    "        vt = self.u - self.u_prev 
    "        gx = np.diff(self.u, axis=1) 
    "        gy = np.diff(self.u, axis=0)
    "        return float(\n",
    "            0.5 * np.sum(vt * vt)\n",
    "            + 0.5 * self.c2 * (np.sum(gx * gx) + np.sum(gy * gy))\n",
    "        )"

         def peak(self):
             return float(np.max(np.abs(self.u)))

         def steady(self):
             return bool(np.all(np.isfinite(self.u)))
   ]
  },
