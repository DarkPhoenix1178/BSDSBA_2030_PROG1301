    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import clear_output, display\n",
    "\n",
    "try:\n",
    "    import ipywidgets as widgets\n",
    "except Exception as exc:\n",
    "    widgets = None\n",
    "    print(\"ipywidgets unavailable:\", exc)\n",
    "\n",
    "if widgets is None:\n",
    "    print(\"\\nInstall with:  pip install ipywidgets\")\n",
    "    print(\"Falling back to a scripted run.\\n\")\n",
    "    fallback = RippleField(size=160, cfl=0.5, damping=0.002)\n",
    "    fallback.splash(80, 80, radius=6, strength=1.0)\n",
    "    fallback.step(160)\n",
    "    plt.figure(figsize=(4.6, 4.6))\n",
    "    plt.imshow(fallback.u, cmap=\"RdBu_r\", vmin=-1.5, vmax=1.5, interpolation=\"bilinear\")\n",
    "    plt.title(\"t = 160, damping = 0.002\")\n",
    "    plt.xticks([])\n",
    "    plt.yticks([])\n",
    "    plt.show()\n",
    "else:\n",
    "\n",
    "    class RipplePanel:\n",
    "        def __init__(self):\n",
    "            self.size = 160\n",
    "            self.field = None\n",
    "            self.output = widgets.Output()\n",
    "            self.damping = widgets.FloatSlider(\n",
    "                value=0.0015, min=0.0, max=0.02, step=0.0005,\n",
    "                description=\"damping\", readout_format=\".4f\", continuous_update=False)\n",
    "            self.cfl = widgets.FloatSlider(\n",
    "                value=0.50, min=0.20, max=0.69, step=0.01,\n",
    "                description=\"speed\", continuous_update=False)\n",
    "            self.strength = widgets.FloatSlider(\n",
    "                value=1.0, min=0.2, max=2.0, step=0.1,\n",
    "                description=\"drop\", continuous_update=False)\n",
    "            self.one = widgets.Button(description=\"Drop centre\")\n",
    "            self.pair = widgets.Button(description=\"Drop pair\")\n",
    "            self.go = widgets.Button(description=\"Advance 40\")\n",
    "            self.reset_button = widgets.Button(description=\"Reset\")\n",
    "\n",
    "            self.one.on_click(self.drop_one)\n",
    "            self.pair.on_click(self.drop_pair)\n",
    "            self.go.on_click(self.advance)\n",
    "            self.reset_button.on_click(self.reset)\n",
    "            self.reset(None)\n",
    "\n",
    "        def new_field(self):\n",
    "            f = RippleField(size=self.size, cfl=float(self.cfl.value),\n",
    "                            damping=float(self.damping.value),\n",
    "                            sponge_width=22, sponge_strength=0.10)\n",
    "            self.field = f\n",
    "            self.scale = 0.85\n",
    "            return f\n",
    "\n",
    "        def reset(self, _):\n",
    "            self.new_field()\n",
    "            self.render(\"t = 0\")\n",
    "\n",
    "        def drop_one(self, _):\n",
    "            if self.field is None:\n",
    "                self.new_field()\n",
    "            c = self.size // 2\n",
    "            self.field.splash(c, c, radius=3.0, strength=float(self.strength.value))\n",
    "            self.render(\"single crater\")\n",
    "\n",
    "        def drop_pair(self, _):\n",
    "            if self.field is None:\n",
    "                self.new_field()\n",
    "            c = self.size // 2\n",
    "            off = self.size // 5\n",
    "            self.field.splash(c - off, c, radius=3.0, strength=float(self.strength.value))\n",
    "            self.field.splash(c + off, c, radius=3.0, strength=float(self.strength.value))\n",
    "            self.render(\"two craters\")\n",
    "\n",
    "        def advance(self, _):\n",
    "            if self.field is None:\n",
    "                self.new_field()\n",
    "            self.field.step(40)\n",
    "            self.render(f\"t = {self.field.t}\")\n",
    "\n",
    "        def render(self, title):\n",
    "            with self.output:\n",
    "                clear_output(wait=True)\n",
    "                fig, ax = plt.subplots(figsize=(4.4, 4.4))\n",
    "                ax.imshow(self.field.u, cmap=\"RdBu_r\",\n",
    "                          vmin=-self.scale, vmax=self.scale,\n",
    "                          interpolation=\"bilinear\")\n",
    "                ax.set_xticks([])\n",
    "                ax.set_yticks([])\n",
    "                ax.set_title(f\"{title}   (gamma = {float(self.damping.value):.4f})\")\n",
    "                plt.tight_layout()\n",
    "                plt.show()\n",
    "\n",
    "    panel = RipplePanel()\n",
    "    display(widgets.VBox([\n",
    "        widgets.HBox([panel.damping, panel.cfl, panel.strength]),\n",
    "        widgets.HBox([panel.one, panel.pair, panel.go, panel.reset_button]),\n",
    "        panel.output,\n",
    "    ]))"
   ]
